APP_NAME="GALIKA Work Lancer"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="galika@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GALIKA_MINIMUM_MATCH_SCORE=70
GALIKA_MAX_AGE_DAYS=30
GALIKA_OPENAI_MODEL=gpt-5.6
GALIKA_DISCOVERY_QUERIES="AI Engineer,Machine Learning Engineer,Data Scientist,Data Engineer,Full Stack Developer,Backend Engineer,Technical Lead,AI Finance"

OPENAI_API_KEY=
GMAIL_ACCESS_TOKEN=
GMAIL_FROM=
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
TINYFISH_API_KEY=
TINYFISH_ENDPOINT=
JOBICY_ENDPOINT=https://jobicy.com/api/v2/remote-jobs


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/galika/oauth/gmail/callback
TINYFISH_HEALTH_ENDPOINT=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null


AIRTABLE_OAUTH_CLIENT_ID=
AIRTABLE_OAUTH_CLIENT_SECRET=
AIRTABLE_OAUTH_REDIRECT_URI=http://localhost/galika/oauth/airtable/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
