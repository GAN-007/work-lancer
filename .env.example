APP_NAME="GALIKA Work Lancer"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="galika@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GALIKA_MINIMUM_MATCH_SCORE=70
GALIKA_FRESH_PRIMARY_HOURS=12
GALIKA_FRESH_FALLBACK_HOURS=24
GALIKA_HEALTH_TOKEN=
GALIKA_OPENAI_MODEL=gpt-5.6
GALIKA_DISCOVERY_QUERIES="AI Engineer,Machine Learning Engineer,Data Scientist,Data Engineer,Full Stack Developer,Backend Engineer,Technical Lead,AI Finance"

OPENAI_API_KEY=
GMAIL_ACCESS_TOKEN=
GMAIL_FROM=
JOBICY_ENDPOINT=https://jobicy.com/api/v2/remote-jobs

# Fully self-hosted browser/search/fetch execution plane.
OPEN_WEB_AGENT_ENDPOINT=http://open-web-agent:8000
OPEN_WEB_AGENT_HEALTH_ENDPOINT=http://open-web-agent:8000/health
OPEN_WEB_AGENT_TOKEN=
OPEN_WEB_AGENT_TIMEOUT=300
OPEN_WEB_AGENT_MAX_ATTACHMENT_BYTES=12582912
OPEN_WEB_AGENT_MAX_STEPS=120
OPEN_WEB_AGENT_CONCURRENCY=2
BROWSER_USE_HEADLESS=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
SEARXNG_URL=http://searxng:8080
GALIKA_OPEN_SEARCH_ENABLED=false
GALIKA_OPEN_SEARCH_RESULTS_PER_QUERY=12
GALIKA_OPEN_FETCH_FALLBACK=false

# Optional self-hosted Airtable-style mirror. PostgreSQL remains authoritative.
BASEROW_ENABLED=false
BASEROW_URL=http://baserow
BASEROW_TOKEN=
BASEROW_TABLE_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/galika/oauth/gmail/callback

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost/galika/oauth/linkedin/callback
LINKEDIN_SCOPES=openid,profile,email

LEVER_CLIENT_ID=
LEVER_CLIENT_SECRET=
LEVER_REDIRECT_URI=http://localhost/galika/oauth/lever/callback
LEVER_SCOPES=

# Optional Laya/System-One decision plane.
# off = no calls; shadow = advisory telemetry only. Existing GALIKA gates remain authoritative.
GALIKA_SYSTEM_ONE_MODE=off
GALIKA_SYSTEM_ONE_BASE_URL=http://127.0.0.1:8000
GALIKA_SYSTEM_ONE_API_KEY=
GALIKA_SYSTEM_ONE_TIMEOUT_SECONDS=1.5
