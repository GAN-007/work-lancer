LINKEDIN_SCOPES=openid,profile,email

LEVER_CLIENT_ID=
LEVER_CLIENT_SECRET=
LEVER_REDIRECT_URI=http://localhost/galika/oauth/lever/callback
LEVER_SCOPES=

# GALIKA PostgreSQL-authoritative runtime
GALIKA_HEALTH_TOKEN=
